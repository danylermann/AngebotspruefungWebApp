@model Check23.Models.Ticket

@{
    ViewData["Title"] = "EditTicket";
}

<h1>Ticket bearbeiten</h1>

<h4>Ticket</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditTicket">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="display:flex">
                <div class="form-group" style="margin-right:5px">
                    <input type="submit" value="Speichern" class="btn btn-dark" />
                </div>
                <div>
                    <a href="javascript:history.back()" class="btn back">Abbrechen</a>
                </div>
            </div>
            <div class="form-group" hidden="hidden">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Number" class="control-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
            <div class="form-group">
                <select asp-for="Type" asp-items="@ViewBag.typeSelectList" class="selectList">
                    <option value="">Tickettyp wählen</option>
                </select>
            </div>
            <div class="form-group" hidden="hidden">
                <label asp-for="QuoteEvaluation_id" class="control-label"></label>
                <input asp-for="QuoteEvaluation_id" class="form-control" />
                <span asp-validation-for="QuoteEvaluation_id" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

