@model IEnumerable<Check23.Models.User>

@{
    ViewData["Title"] = "UserList";
}

<h1>Liste der Nutzer</h1>

<div>
    @Html.ActionLink("Benutzer hinzufügen", "CreateUser", "User", null, new { @class="btn btn-dark" })    
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.ActionLink("Bearbeiten", "EditUser", new { userId = item.Id }, new { @class="defaultbtn" })                                 
            </td>
        </tr>
}
    </tbody>
</table>
