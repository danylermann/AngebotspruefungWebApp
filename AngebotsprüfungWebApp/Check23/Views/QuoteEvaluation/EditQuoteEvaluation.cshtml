@model Check23.Models.QuoteEvaluation

@{
    ViewData["Title"] = "EditQuoteEvaluation";    
}
<head>
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#txt'
        });
    </script>
</head>

<h1>Bearbeiten</h1>

<h4>Angebotsprüfung</h4>
<hr />
<div style="color:red ">@ViewBag.validationError</div>
<div class="row">
    <div class="col-md-4">
        <form asp-action="ProcessEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="display:flex">
                <div class="form-group" style="margin-right:5px">
                    <input type="submit" value="Speichern" class="btn btn-dark" />
                </div>
                <div>
                    <a href="javascript:history.back()" class="btn back">Abbrechen</a>
                </div>
            </div>
             <div class="form-group" hidden="hidden">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div> 
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control"  /> 
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Client_id" class="control-label">Kunde</label>
            </div>
            <div class="form-group">
                <select asp-for="Client_id" asp-items="@ViewBag.clientsSelectList" class="selectList">
                    <option value="">Kunde auswählen(optional)</option>
                </select>
                @Html.ActionLink("Kunden erstellen", "CreateClient", "Client")
            </div>
            <div class="form-group" hidden="hidden">
                <label asp-for="Creator" class="control-label"></label>
                <input asp-for="Creator" class="form-control" />
                <span asp-validation-for="Creator" class="text-danger"></span>
            </div>
            <div class="form-group" hidden="hidden">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div> 
            <div class="form-group">
                <label asp-for="LegalGuidelines" class="control-label"></label>
                <input asp-for="LegalGuidelines" class="form-control"  />
                <span asp-validation-for="LegalGuidelines" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExternalContact" class="control-label"></label>
                <input asp-for="ExternalContact" class="form-control"  />
                <span asp-validation-for="ExternalContact" class="text-danger"></span>
            </div>
            <div class="form-group" hidden="hidden">
                <input type="radio" asp-for="OrderCategory" value="1" />Angebotsprüfung<br />
                <input type="radio" asp-for="OrderCategory" value="2" />Entwicklungsauftrag<br />
                <span asp-validation-for="OrderCategory" class="text-danger"></span>
            </div>
            <input hidden="hidden" name="oldName" value="@Model.Name" />
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
