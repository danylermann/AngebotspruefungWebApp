@model Check23.Models.Requirement

@{
    ViewData["Title"] = "CreateRequirement";
}
<head>
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#txt'
        });
    </script>
</head>

<h1>Neue Anforderung erstellen</h1>
<h2>@ViewBag.quoteEvalName</h2>

<h4>Anforderung</h4>
<hr />
<div style="color:red ">@Model.ErrorMessage</div>
<div class="row">
    <div class="col-md-4">
        <form asp-action="ProcessCreate"  >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="display:flex">
                <div class="form-group" style="margin-right:5px">
                    <input type="submit" value="Erstellen" class="btn btn-dark" />
                </div>
                <div>
                    @Html.ActionLink("Abbrechen", "DetailsQuoteEvaluation", "QuoteEvaluation", new { quoteEvalId = ViewBag.quoteEvalId }, new { @class = "btn back" }) @*ActionLink weil session back unter Umständen zurück zum erstellen einer Angebotsprüfung führen könnte welche aber bereits erstellt wurde => verwirrung für den Nutzer und gegebenenfalls Mehrfacherstellung der selben Angebotsprüfung*@
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input id="txt" asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div>
                <table class="table" style="width:max-content">
                    <thead>
                        <tr>
                            <th>ESW</th>
                            <th></th>
                            <th>EHW</th>
                            <th></th>
                            <th>Andere</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.ESW_CEETIS)</div>
                                <div>@Html.DisplayNameFor(model => model.ESW_IVISionStudio)</div>
                                <div>@Html.DisplayNameFor(model => model.ESW_Netstar)</div>
                                <div>@Html.DisplayNameFor(model => model.ESW_InterneTools)</div>
                                <div>@Html.DisplayNameFor(model => model.ESW_Other)</div>
                            </td>
                            <td>
                                <div>
                                    <input class="form-check-input" asp-for="ESW_CEETIS" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="ESW_IVISionStudio" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="ESW_Netstar" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="ESW_InterneTools" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="ESW_Other" />
                                </div>
                            </td>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.EHW_HV_Tester)</div>
                                <div>@Html.DisplayNameFor(model => model.EHW_Construction)</div>
                                <div>@Html.DisplayNameFor(model => model.EHW_TPMs)</div>
                                <div>@Html.DisplayNameFor(model => model.EHW_LV_Tester)</div>
                                <div>@Html.DisplayNameFor(model => model.EHW_InterneTools)</div>
                                <div>@Html.DisplayNameFor(model => model.EHW_Other)</div>
                            </td>
                            <td>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_HV_Tester" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_Construction" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_TPMs" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_LV_Tester" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_InterneTools" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="EHW_Other" />
                                </div>
                            </td>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.Documentation)</div>
                                <div>@Html.DisplayNameFor(model => model.Service)</div>
                            </td>
                            <td>
                                <div>
                                    <input class="form-check-input" asp-for="Documentation" />
                                </div>
                                <div>
                                    <input class="form-check-input" asp-for="Service" />
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
@*             <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CDE" /> @Html.DisplayNameFor(model => model.CDE)
                </label>
            </div> *@
            <div class="form-group">
                <label asp-for="OrderNumber" class="control-label"></label>
                <input asp-for="OrderNumber" class="form-control" />
                <span asp-validation-for="OrderNumber" class="text-danger"></span>
            </div>
            @Html.DisplayNameFor(model => model.NotToBeCarriedOut)
            <div class="form-group form-check">                
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="NotToBeCarriedOut" />
                </label>
            </div>
            <div class="form-group" hidden="hidden">
                <label asp-for="QuoteEvaluation_id" class="control-label"></label>
                <input asp-for="QuoteEvaluation_id" class="form-control" value="@ViewBag.quoteEvalId" />
                <span asp-validation-for="QuoteEvaluation_id" class="text-danger"></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
