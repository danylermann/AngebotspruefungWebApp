@model Check23.Models.AccessGroup

@{
    ViewData["Title"] = "DetailsAccessGroup";
}

<h1>@Model.Name</h1>

<div>
    <h4>Zugriffsgruppe</h4>
    <hr />
    <div>
        @Html.ActionLink("Zugriffsgruppe bearbeiten", "EditAccessGroup", new { accessGroupId = Model.Id }, new { @class="btn btn-dark" })
        <a asp-action="AccessGroupList" class="btn back">Zurück zur Liste</a>
    </div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-2">
            Bearbeitungsberechtigungen
        </dt>
        <dd class="col-sm-10">
            <table class="table" style="width:max-content">
                <thead>
                    <tr>
                        <th>
                            Administration
                        </th>
                        <th></th>
                        <th>
                            Vertrieb
                        </th>
                        <th></th>
                        <th>
                            Entwicklung
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div>@Html.DisplayNameFor(model => model.CreateUser)</div>
                            <div>@Html.DisplayNameFor(model => model.CreateAccessGroup)</div>
                        </td>
                        <td>
                            <div>@Html.DisplayFor(model => model.CreateUser)</div>
                            <div>@Html.DisplayFor(model => model.CreateAccessGroup)</div>
                        </td>
                        <td>
                            <div>@Html.DisplayNameFor(model => model.CreateQuoteEvaluation)</div>
                            <div>@Html.DisplayNameFor(model => model.CreateRequirement)</div>
                            <div>@Html.DisplayNameFor(model => model.CreateClient)</div>
                        </td>
                        <td>
                            <div>@Html.DisplayFor(model => model.CreateQuoteEvaluation)</div>
                            <div>@Html.DisplayFor(model => model.CreateRequirement)</div>
                            <div>@Html.DisplayFor(Model => Model.CreateClient)</div>
                        </td>
                        <td>
                            <div>@Html.DisplayNameFor(model => model.CreateSolution)</div>
                            <div>@Html.DisplayNameFor(model => model.CreateEstimation)</div>
                        </td>
                        <td>
                            <div>@Html.DisplayFor(model => model.CreateSolution)</div>
                            <div>@Html.DisplayFor(model => model.CreateEstimation)</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </dd>
    </dl>
