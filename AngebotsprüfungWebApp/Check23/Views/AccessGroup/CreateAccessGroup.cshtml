@model Check23.Models.AccessGroup

@{
    ViewData["Title"] = "CreateAccessGroup";
}

<h1>Neue Zugriffsgruppe erstellen</h1>

<h4>Zgriffsgruppe</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ProcessCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="display:flex">
                <div class="form-group" style="margin-right:5px">
                    <input type="submit" value="Erstellen" class="btn btn-dark" />
                </div>
                <div>
                    <a href="javascript:history.back()" class="btn back">Abbrechen</a>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div>
                <table class="table" style="width:max-content">
                    <thead>
                        <tr>
                            <th>
                                Administration
                            </th>
                            <th></th>
                            <th>
                                Vertrieb
                            </th>
                            <th></th>
                            <th>
                                Entwicklung
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.CreateUser)</div>
                                <div>@Html.DisplayNameFor(model => model.CreateAccessGroup)</div>
                            </td>
                            <td>
                                <div><input class="form-check-input" asp-for="CreateUser" /></div>
                                <div><input class="form-check-input" asp-for="CreateAccessGroup" /></div>
                            </td>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.CreateQuoteEvaluation)</div>
                                <div>@Html.DisplayNameFor(model => model.CreateRequirement)</div>
                                <div>@Html.DisplayNameFor(model => model.CreateClient)</div>
                            </td>
                            <td>
                                <div><input class="form-check-input" asp-for="CreateQuoteEvaluation" /></div>
                                <div><input class="form-check-input" asp-for="CreateRequirement" /></div>
                                <div><input class="form-check-input" asp-for="CreateClient" /></div>
                            </td>
                            <td>
                                <div>@Html.DisplayNameFor(model => model.CreateSolution)</div>
                                <div>@Html.DisplayNameFor(model => model.CreateEstimation)</div>
                            </td>
                            <td>
                                <div><input class="form-check-input" asp-for="CreateSolution" /></div>
                                <div><input class="form-check-input" asp-for="CreateEstimation" /></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>

